# Production values. cms.mesropants.com is the WordPress backend (WPGraphQL +
# REST); mesropants.com is the public Next.js frontend. Assumes WordPress is
# deployed at the root of cms.mesropants.com (no /mesropants_wp/ path segment
# -- that's just the local dev folder name) -- confirm before deploying.
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=https://cms.mesropants.com/graphql
NEXT_PUBLIC_WORDPRESS_REST_URL=https://cms.mesropants.com/wp-json
NEXT_PUBLIC_SITE_URL=https://mesropants.com
